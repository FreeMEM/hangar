# Test generado por tools/vectores.py (no editar): los casos del resolutor del formato 2 (tests/vectores/
# resolver.txt, copiados del servicio) con src/resolutor.dash.
# expect-out: resolutor 33/33
import "../src/resolutor.dash"

func meter(repo: String, campos: String)
    for e in formato_entradas("X\n\n" + campos)
        resolutor_meter(repo, e)
    end
end

func comprobar(titulo: String, esperado: String) -> Int
    sale = ""
    for l in resolutor_lineas()
        sale = sale + l + "\n"
    end
    if sale == esperado
        return 1
    end
    Print "MAL " + titulo
    Print sale
    return 0
end

