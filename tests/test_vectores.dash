# Test generado por tools/vectores.py (no editar): los vectores del formato de paquetes 2 (tests/vectores,
# copiados del servicio): comparación de versiones con epoch y requisitos en forma canónica.
# expect-out: versiones 28/28
# expect-out: requisitos 15/15
import "../src/formato.dash"

func signo(k: Int) -> String
    if k < 0
        return "<"
    elif k > 0
        return ">"
    end
    return "="
end

func inverso(s: String) -> String
    if s == "<"
        return ">"
    elif s == ">"
        return "<"
    end
    return s
end

